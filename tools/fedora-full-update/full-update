#!/usr/bin/env bash
# Refresh Fedora packages, Flatpaks, and installed coding CLIs.
set -euo pipefail

echo "==> dnf upgrade --refresh"
sudo dnf upgrade --refresh -y

if command -v flatpak >/dev/null 2>&1; then
  echo "==> flatpak update"
  flatpak update -y
else
  echo "==> flatpak not installed; skipping"
fi

for tool in grok pi codex claude; do
  if command -v "$tool" >/dev/null 2>&1; then
    echo "==> $tool update"
    if ! "$tool" update; then
      echo "==> warning: $tool update failed; continuing" >&2
    fi
  else
    echo "==> $tool not installed; skipping"
  fi
done

echo "==> done"
